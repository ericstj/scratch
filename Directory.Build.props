<Project>
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;netcoreapp2.0;netcoreapp2.1;netcoreapp3.0;netcoreapp3.1;net5.0;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' and $([MSBuild]::VersionGreaterThanOrEquals('$(TargetFrameworkVersion)', '3.0'))">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <Target Name="CopyReferences" DependsOnTargets="ResolveReferences" Returns="@(CopiedReferences)">
    <Message Importance="high" Text="Copying references to 'References' folder..." />
    <ItemGroup>
      <CopiedReferences Include="@(ReferencePath->'$(TargetDir)\References\%(FileName)%(Extension)')" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)\References" />
    <Copy SourceFiles="@(ReferencePath)" DestinationFiles="@(CopiedReferences)" SkipUnchangedFiles="true" />
  </Target>

</Project>