<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Pruning data has some downgrades -->
    <NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>

  <UsingTask TaskName="GetPackagesToPrune" AssemblyFile="C:\src\dotnet\sdk\artifacts\bin\Debug\Sdks\Microsoft.NET.Sdk\tools\net10.0\Microsoft.NET.Build.Tasks.dll" />

  <!-- Don't bring in any framework references, instead reference every package in the pruning list --> 
  <Target Name="AddPackageReferences" BeforeTargets="CollectPrunePackageReferences"
          DependsOnTargets="ProcessFrameworkReferences">

    <PropertyGroup>
      <PrunePackageDataRoot Condition="'$(PrunePackageDataRoot)' == ''">$(NetCoreRoot)\sdk\$(NETCoreSdkVersion)\PrunePackageData\</PrunePackageDataRoot>
      <PrunePackageTargetingPackRoots Condition="'$(PrunePackageTargetingPackRoots)' == ''">$(NetCoreTargetingPackRoot)</PrunePackageTargetingPackRoots>
      <AllowMissingPrunePackageData Condition="'$(AllowMissingPrunePackageData)' == ''">false</AllowMissingPrunePackageData>
    </PropertyGroup>
    
    <GetPackagesToPrune TargetFrameworkIdentifier="$(TargetFrameworkIdentifier)"
                        TargetFrameworkVersion="$(_TargetFrameworkVersionWithoutV)"
                        FrameworkReferences="@(FrameworkReference)"
                        TargetingPacks="@(TargetingPack)"
                        TargetingPackRoots="$(PrunePackageTargetingPackRoots)"
                        PrunePackageDataRoot="$(PrunePackageDataRoot)"
                        AllowMissingPrunePackageData="$(AllowMissingPrunePackageData)">
      <Output TaskParameter="PackagesToPrune" ItemName="_PackageReference" />
    </GetPackagesToPrune>

    <ItemGroup>
      <PackageReference Include="%(_PackageReference.Identity)" Version="$([System.String]::new('%(_PackageReference.Version)').Replace('32767', '*'))" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Condition="'%(PackageReference.Version)' == '10.0.*'" Version="10.0.0-*" />
    </ItemGroup>

    <!-- We have some imaginary version in net9.0 & 10.0 -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'net9.0'"  >
      <PackageReference Condition="'%(Identity)' == 'System.Xml.XPath.XDocument'" Version="4.*" />
      <PackageReference Condition="'%(Identity)' == 'Microsoft.VisualBasic'" Version="10.*" />
      <PackageReference Condition="'%(Identity)' == 'System.Buffers'" Version="4.*" />
      <PackageReference Condition="'%(Identity)' == 'System.Memory'" Version="4.*" />
      <PackageReference Condition="'%(Identity)' == 'System.Numerics.Vectors'" Version="4.*" />
      <PackageReference Condition="'%(Identity)' == 'System.Reflection.DispatchProxy'" Version="4.*" />
      <PackageReference Condition="'%(Identity)' == 'System.Runtime.CompilerServices.Unsafe'" Version="6.*" />
      <PackageReference Condition="'%(Identity)' == 'System.Threading.Tasks.Extensions'" Version="4.*" />
      <PackageReference Remove="System.Formats.Tar" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Antiforgery'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Authentication.Abstractions'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Authentication.Cookies'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Authentication.Core'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Authentication'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Authentication.OAuth'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Authorization.Policy'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Components.Server'" Version="3.0.0-preview3-19153-02" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.CookiePolicy'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Cors'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Diagnostics.Abstractions'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Diagnostics'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Diagnostics.HealthChecks'" Version="2.2.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.HostFiltering'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Hosting.Abstractions'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Hosting'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Hosting.Server.Abstractions'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Html.Abstractions'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Http.Abstractions'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Http.Connections'" Version="1.2.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Http'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Http.Extensions'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Http.Features'" Version="6.0.0-preview.4.21253.5" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.HttpOverrides'" Version="2.3.5" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.HttpsPolicy'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Identity'" Version="2.3.1" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Localization'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Localization.Routing'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Mvc.Abstractions'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Mvc.ApiExplorer'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Mvc.Core'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Mvc.Cors'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Mvc.DataAnnotations'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Mvc'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Mvc.Formatters.Json'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Mvc.Formatters.Xml'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Mvc.Localization'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Mvc.Razor'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Mvc.RazorPages'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Mvc.TagHelpers'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Mvc.ViewFeatures'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.RateLimiting'" Version="7.0.0-rc.2.22476.2" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Razor'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Razor.Runtime'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.ResponseCaching.Abstractions'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.ResponseCaching'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.ResponseCompression'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Rewrite'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Routing.Abstractions'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Routing'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Server.HttpSys'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Server.IIS'" Version="2.2.6" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Server.IISIntegration'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Server.Kestrel.Core'" Version="2.3.6" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Server.Kestrel'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Server.Kestrel.Transport.Quic'" Version="6.0.0-preview.6.21355.2" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Server.Kestrel.Transport.Sockets'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.Session'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.SignalR.Core'" Version="1.2.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.SignalR'" Version="1.2.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.StaticFiles'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.WebSockets'" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.App'" Version="3.0.0-preview3-19153-02" />
      
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.Net.Http.Headers' AND  $([MSBuild]::VersionLessThan('$(TargetFrameworkVersion)', '8.0'))" Version="2.3.0" />
      <PackageReference  Condition="'%(Identity)' == 'Microsoft.AspNetCore.WebUtilities' AND  $([MSBuild]::VersionLessThan('$(TargetFrameworkVersion)', '8.0'))" Version="2.3.0" />
            
      <PackageReference Remove="Microsoft.AspNetCore.StaticAssets" />
      <PackageReference Remove="Microsoft.AspNetCore.Http.Results" />
      <PackageReference Remove="Microsoft.AspNetCore.HttpLogging" />
      <PackageReference Remove="Microsoft.AspNetCore.OutputCaching" />
      <PackageReference Remove="Microsoft.AspNetCore.RequestDecompression" />
      <PackageReference Remove="Microsoft.AspNetCore.Authentication.BearerToken" />
      <PackageReference Remove="Microsoft.AspNetCore.Components.Endpoints" />
      <PackageReference Remove="Microsoft.AspNetCore.Server.Kestrel.Transport.NamedPipes" />
    </ItemGroup>

  </Target>
</Project>
